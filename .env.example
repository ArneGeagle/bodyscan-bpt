# Copy this to .env and fill in your values
DB_HOST=mysql
DB_PORT=3306
DB_NAME=kelp
DB_USER=kelp
DB_PASSWORD=changeme

JWT_SECRET=replace_with_a_long_random_string_minimum_32_chars
JWT_EXPIRES_IN=7d

PORT=3000
NODE_ENV=production

# Port nginx listens on (use 8080 for rootless Docker, or 80 for root Docker)
HTTP_PORT=8080
